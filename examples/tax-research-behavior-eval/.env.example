# Braintrust Gateway credentials for the behavior judge.
# Copy this file to .env or export these variables in your shell.
BRAINTRUST_API_KEY=bt_your_api_key_here

# The judge uses BRAINTRUST_JUDGE_MODEL first, then BRAINTRUST_MODEL.
BRAINTRUST_JUDGE_MODEL=gpt-5-mini
BRAINTRUST_GATEWAY_BASE_URL=https://gateway.braintrust.dev
