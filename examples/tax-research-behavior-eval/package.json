{
  "name": "@agentbehavior/tax-research-behavior-eval",
  "version": "0.0.0",
  "private": true,
  "description": "Toy true/false/NA behavior judge over fictional tax-research trajectories.",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "eval": "bt eval --runner tsx primary-source-tax-research.eval.ts",
    "eval:local": "bt eval --runner tsx --no-send-logs primary-source-tax-research.eval.ts",
    "test": "vp test --run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:eval": "tsc -p tsconfig.eval.json"
  },
  "dependencies": {
    "agentbehavior": "workspace:*",
    "braintrust": "^3.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4"
  },
  "engines": {
    "node": ">=20"
  }
}
